{
  "_说明": "CodeStatus 通用监控指纹库。要加新的 AI 工具，在 fingerprints 数组里照格式加一条即可，无需改代码。enabled=false 可临时关掉某个工具。改完重启「启动AI工具监控」生效。",
  "agentUrl": "http://127.0.0.1:4317/api/events",
  "fallbackUrl": "http://127.0.0.1:4317/events",
  "pollMs": {
    "foreground": 1500,
    "process": 4000,
    "http": 8000
